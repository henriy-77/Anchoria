# Copy to .env and fill in. NEVER commit the real .env.

# The public address of the site (no https://). Its DNS A record must point at this server.
SITE_DOMAIN=onboard.anchoriaonline.com
SITE_URL=https://onboard.anchoriaonline.com

# Staff sign-in. SESSION_SECRET: a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: keep mirroring new applications to Airtable. Leave both blank to run without Airtable.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
